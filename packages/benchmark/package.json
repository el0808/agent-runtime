{
  "name": "@agent/benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "bench:live": "node --experimental-strip-types dist/live-run.js",
    "bench:humaneval": "node --experimental-strip-types dist/humaneval-run.js"
  },
  "dependencies": {
    "@agent/protocol": "workspace:*",
    "@agent/runner": "workspace:*",
    "@agent/runtime": "workspace:*"
  },
  "files": [
    "dist",
    "data"
  ]
}

{
  "name": "@agent/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-runtime": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@agent/memory": "workspace:*",
    "@agent/pet-adapter": "workspace:*",
    "@agent/policy": "workspace:*",
    "@agent/protocol": "workspace:*",
    "@agent/routing": "workspace:*",
    "@agent/runner": "workspace:*",
    "@agent/sync": "workspace:*",
    "@agent/task-ledger": "workspace:*",
    "@agent/tools": "workspace:*",
    "@agent/verifier": "workspace:*"
  }
}
